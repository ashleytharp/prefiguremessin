<diagram dimensions="(300, 300)" margins="5">
<definition>f(x)=sqrt(x)</definition>
<definition>g(x)=-1*sqrt(x)</definition>
<definition>j(x)=sqrt(6-x)</definition>
<definition>k(x)=-1*sqrt(6-x)</definition>
<coordinates bbox="[-1,-3,7,3]">
<grid-axes/>
<area-between-curves functions="(f,g)" domain="(0.001,3)" fill="lightgray" stroke="lightgray"/>
<area-between-curves function1="j" function2="k" domain="(3,5.999)" fill="lightgray" stroke="lightgray"/>
<graph function="f" domain="(0,7)"/>
<graph function="g" domain="(0,7)"/>
<graph function="k" domain="(-1,6)"/>
<graph function="j" domain="(-1,6)"/>
<label p="(5.25,2.25)" alignment="northeast" clear-background="yes">
<m>x=y^2</m>
</label>
<label p="(.75,2.25)" alignment="northeast" clear-background="yes">
<m>x=6-y^2</m>
</label>
</coordinates>
</diagram>